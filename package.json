{
  "name": "my-app",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build:dev": "pnpm build:extension:dev",
    "build:prod": "pnpm build:extension:prod",
    "build:extension": "pnpm build:extension:dev",
    "build:extension:dev": "vite build --mode development",
    "build:extension:prod": "vite build --mode production",
    "validate:prod": "node scripts/validate-prod.mjs",
    "build:package": "pnpm build:dev && rm -rf release && mkdir -p release && cd build && zip -rq ../release/chrome-extension.zip .",
    "build:package:prod": "pnpm build:prod && pnpm validate:prod && rm -rf release && mkdir -p release && cd dist && zip -rq ../release/chrome-extension.zip .",
    "bump:libqc": "node scripts/bump-libqc.mjs",
    "ci:pr": "pnpm run l:c && pnpm run p:c && pnpm run typecheck && pnpm run knip && pnpm run test:unit && pnpm run build:prod && pnpm run validate:prod && pnpm dlx @project-eleven/dep-doc@0.0.4 --run",
    "dev": "pnpm dev:hmr",
    "dev:hmr": "vite --mode development",
    "diagnostics:runtime": "node scripts/print-runtime-diagnostics.mjs",
    "lint": "eslint .",
    "l:c": "eslint \"./**/*.{ts,tsx}\"",
    "l:f": "eslint \"./**/*.{ts,tsx}\" --fix",
    "libqc:freshness": "node scripts/libqc-freshness.mjs --require-latest",
    "libqc:latest": "node scripts/libqc-freshness.mjs --print-latest",
    "p:c": "prettier --config .prettierrc \"./**/*.+(js|json|ts|tsx)\" --check --ignore-unknown",
    "p:f": "prettier --config .prettierrc \"./**/*.+(js|json|ts|tsx)\" --write --ignore-unknown",
    "preview": "vite preview",
    "qa:prep": "bash scripts/qa-prep.sh",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --project=smoke",
    "test:e2e:flows": "playwright test --project=flows",
    "test:e2e:security": "playwright test --project=security",
    "test:e2e:full": "playwright test --project=flows --project=security",
    "test:e2e:full:ci": "playwright test --project=flows --project=security --max-failures=0",
    "typecheck": "tsc -p tsconfig.typecheck.json && tsc -p tsconfig.node.json",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "knip": "knip --include dependencies,devDependencies,unlisted,binaries",
    "verify:libqc-source": "bash .github/scripts/verify-libqc-source.sh"
  },
  "dependencies": {
    "@project-eleven/libqc": "1.0.0",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tabs": "1.1.13",
    "@tailwindcss/vite": "4.2.1",
    "@tanstack/react-query": "5.99.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "12.34.4",
    "lucide-react": "1.17.0",
    "qrcode.react": "4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "2.0.7",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "4.2.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.4.0",
    "@eslint/js": "9.39.3",
    "@playwright/test": "1.52.0",
    "@types/node": "24.11.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "17.3.1",
    "eslint": "9.39.3",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "knip": "6.6.0",
    "only-allow": "1.2.2",
    "prettier": "3.8.1",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vite": "7.3.2",
    "vite-plugin-node-polyfills": "0.24.0",
    "vite-plugin-static-copy": "3.2.0",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "overrides": {
      "tar@<=7.5.7": "7.5.8",
      "rollup@<4.59.0": "4.59.0",
      "picomatch@<4.0.4": "4.0.4"
    }
  },
  "knip": {
    "ignoreDependencies": [
      "babel-plugin-react-compiler"
    ]
  }
}
